{
  "name": "@jitera/connect",
  "version": "1.2.3",
  "type": "module",
  "description": "Connect AI coding assistants to Jitera projects: documentation, source, and shared project memory",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jitera-Product/connect.git"
  },
  "keywords": [
    "jitera",
    "mcp",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "connect": "./dist/bin/connect.js",
    "jitera-connect": "./dist/bin/connect.js"
  },
  "files": [
    "dist/",
    "skills/",
    "hooks/",
    "content/",
    "templates/",
    ".claude-plugin/",
    ".codex-plugin/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate": "node src/bin/validate.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
